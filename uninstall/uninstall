#!/bin/bash
# Creality2Lox - Deinstallation (Bauart Saugroboter-Valetudo 1.1.37).
#
# Haelt die eigene Befehlsbruecke an (und nur sie), entfernt deren Optionsdateien mit der Broker-Anmeldung, leert
# die zurueckbehaltenen MQTT-Themen der Linie und entfernt Zweitschrift, beiseitegelegte Zweitschrift, Upgrade-Marke
# und Zwischenspeicher. Den Drucker beruehrt sie nicht. Argumente: $2 Plugin-Name, $3 Ordnername, $5 Wurzel.

if [ -n "$2" ] && [ "$2" != "creality2lox" ]; then
    echo "<INFO> Deinstallation von '$2' - betrifft Creality2Lox nicht, nichts getan."
    exit 0
fi
PDIR=$3
[ -n "$PDIR" ] || PDIR="creality2lox"
case "$PDIR" in
    */*|*..*) echo "<WARNING> Unzulaessiger Ordnername '$PDIR' - nichts entfernt."; exit 1 ;;
esac
BASE="${5:-$LBHOMEDIR}"

cr_wurzel_suchen() {
    cr_v=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    cr_i=0
    while [ -n "$cr_v" ] && [ "$cr_v" != "/" ] && [ "$cr_i" -lt 8 ]; do
        if [ -d "$cr_v/config/plugins" ] && [ -d "$cr_v/data/plugins" ] \
           && [ -f "$cr_v/config/system/general.json" ]; then
            echo "$cr_v"
            return 0
        fi
        cr_v=$(dirname "$cr_v")
        cr_i=$((cr_i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ] \
   || [ ! -f "$BASE/config/system/general.json" ]; then
    BASE=$(cr_wurzel_suchen "$(dirname "$(readlink -f "$0")")") || BASE=""
fi
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden - es wurde NICHTS geloescht."
    exit 1
fi

BBSH="$BASE/bin/plugins/$PDIR/befehlsbruecke.sh"
BBPHP="$BASE/bin/plugins/$PDIR/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PDIR/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop
fi
# Reste des eigenen Dienstes argumentweise erkennen (genau "php <bin>/befehlsbruecke.php"), nie fremde Prozesse.
BBREST=0
for D in /proc/[0-9]*; do
    mapfile -d '' -t BBA 2>/dev/null < "$D/cmdline" || continue
    if [ "${#BBA[@]}" -eq 2 ] && [ "${BBA[1]}" = "$BBPHP" ] && [[ "${BBA[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${D#/proc/}" 2>/dev/null
        BBREST=$((BBREST + 1))
    fi
done
BBABOS=0
for D in /proc/[0-9]*; do
    read -r BBC 2>/dev/null < "$D/comm" || continue
    [ "$BBC" = "mosquitto_sub" ] || continue
    mapfile -d '' -t BBE 2>/dev/null < "$D/environ" || continue
    for BBX in "${BBE[@]}"; do
        if [ "$BBX" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${D#/proc/}" 2>/dev/null; BBABOS=$((BBABOS + 1)); fi
    done
done
[ "$BBREST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BBREST Dienst(e) erst mit kill -9 beendet."
[ "$BBABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BBABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for BBF in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$BBF" ]; then
            BBN=$(stat -c %s "$BBF" 2>/dev/null || echo 64)
            head -c "$BBN" /dev/zero > "$BBF" 2>/dev/null
        fi
    done
    rm -rf "$BBDIR"
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
else
    echo "<OK> Befehlsbruecke angehalten, Zugangsdaten der Befehlsbruecke entfernt."
fi

CR_CRON="$BASE/bin/plugins/$PDIR/cron.php"
if command -v php >/dev/null 2>&1 && [ -f "$CR_CRON" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
            timeout 60 php "$CR_CRON" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 60 php "$CR_CRON" --mqtt-leeren < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder cron.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

BK="$BASE/config/plugins/$PDIR.backup.json"
CR_REST=""
for CR_D in "$BK" "$BK.alt" "$BASE/data/plugins/$PDIR.upgrade_laeuft"; do
    if [ -e "$CR_D" ] || [ -L "$CR_D" ]; then
        rm -f "$CR_D" 2>/dev/null
        if [ -e "$CR_D" ] || [ -L "$CR_D" ]; then
            CR_REST="$CR_REST $CR_D"
        else
            echo "<OK> Entfernt: $(basename "$CR_D")"
        fi
    fi
done
if [ -n "$CR_REST" ]; then
    echo "<WARNING> Nicht zu entfernen, bitte von Hand loeschen (darin stehen Druckeradresse und Aktionstoken):$CR_REST"
fi
if [ -d "/tmp/$PDIR" ]; then
    rm -rf "/tmp/$PDIR" && echo "<OK> Zwischenspeicher /tmp/$PDIR entfernt."
fi
if [ -f "/tmp/$PDIR-cron.log" ]; then
    rm -f "/tmp/$PDIR-cron.log" && echo "<OK> Cron-Protokoll /tmp/$PDIR-cron.log entfernt."
fi
echo "<INFO> Klipper und Moonraker laufen auf dem Drucker selbst und bleiben unberuehrt."
exit 0
